// ISOLATED EMULATOR ONLY. Never referenced by production firebase.json.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {return request.auth != null && request.auth.uid == uid;}
    match /teacherTimetableSync/{uid} {
      function receipt(id) {return /databases/$(database)/documents/teacherTimetableSync/$(uid)/receipts/$(id);}
      function valid(d) {
        return d.keys().hasOnly(['schemaVersion','ownerId','revision','operationId','payloadJson'])
          && d.keys().hasAll(['schemaVersion','ownerId','revision','operationId','payloadJson'])
          && d.schemaVersion == 1 && d.ownerId == uid
          && d.revision is int && d.revision >= 0
          && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 128
          && d.payloadJson is string && d.payloadJson.size() <= 180000
          && !exists(receipt(d.operationId)) && existsAfter(receipt(d.operationId))
          && getAfter(receipt(d.operationId)).data.revision == d.revision
          && getAfter(receipt(d.operationId)).data.payloadJson == d.payloadJson;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(request.resource.data) && request.resource.data.revision == 0;
      allow update: if owner(uid) && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
      match /receipts/{operationId} {
        function parent() {return /databases/$(database)/documents/teacherTimetableSync/$(uid);}
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasAll(['ownerId','revision','expectedRevision','payloadJson'])
          && request.resource.data.keys().hasOnly(['ownerId','revision','expectedRevision','payloadJson'])
          && request.resource.data.ownerId == uid
          && getAfter(parent()).data.operationId == operationId
          && getAfter(parent()).data.revision == request.resource.data.revision
          && getAfter(parent()).data.payloadJson == request.resource.data.payloadJson
          && ((!exists(parent()) && request.resource.data.expectedRevision == null
               && request.resource.data.revision == 0)
            || (exists(parent()) && request.resource.data.expectedRevision == get(parent()).data.revision
                && request.resource.data.revision == get(parent()).data.revision + 1));
        allow update, delete: if false;
      }
    }
  }
}
