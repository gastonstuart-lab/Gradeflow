rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    // Preserve the existing private academic-data ownership boundary.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Temporary containment: shared Messages stays closed until reviewed
    // school/channel grants and the verified client are ready together.
    match /schools/{schoolKey}/communicationChannels/{document=**} {
      allow read, write: if false;
    }
  }
}
